MPT_ENV=production
MPT_HOST=0.0.0.0
# Railway automatically provides PORT; MPT_PORT is the local fallback.
MPT_PORT=8000
MPT_COOKIE_SECURE=1
# Required only for the first unattended production start. Remove the password
# after the administrator account has been created.
MPT_TEACHER_USERNAME=
MPT_TEACHER_PASSWORD=
MPT_CLASS_NAME=默认班级
MPT_GROUP_COUNT=3
# Optional stable Fernet key. If omitted, it is generated inside /app/data.
MPT_ACCOUNT_ENCRYPTION_KEY=
# One-time data reset marker. Leave blank normally. A new unique value triggers
# one backed-up reset while retaining the administrator identity.
MPT_RESET_DATA_ONCE=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# Free AI workspace text and image models share this Volcengine Ark key.
ARK_API_KEY=
ARK_TEXT_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# Standard model ID; old 2.0 mini values are migrated automatically.
ARK_TEXT_MODEL=doubao-seed-2-1-turbo-260628
ARK_RESPONSES_URL=https://ark.cn-beijing.volces.com/api/v3/responses
# Optional directory containing the platform's built-in PDF/DOCX knowledge files.
MPT_KNOWLEDGE_SOURCE_DIR=
# Optional teacher-plan model/endpoint; must support images and JSON output.
# Defaults to ARK_TEXT_MODEL; uses the same ARK_API_KEY.
ARK_PLAN_MODEL=
# Text requests use SSE streaming in the free AI workspace; this is the upstream read timeout.
ARK_TEXT_TIMEOUT_SECONDS=60
ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_RESPONSE_FORMAT=b64_json
ARK_IMAGE_TIMEOUT_SECONDS=120
# Client-side key from https://www.desmos.com/my-api; restrict it to the deployment domain.
DESMOS_API_KEY=
# Optional visual model for photo transcription and image conversations; defaults to ARK_TEXT_MODEL.
ARK_VISION_MODEL=
