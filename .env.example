MPT_ENV=production
MPT_HOST=0.0.0.0
# Railway automatically provides PORT; MPT_PORT is the local fallback.
MPT_PORT=8000
MPT_COOKIE_SECURE=1
MPT_SETUP_TOKEN=replace-with-a-one-time-token-at-least-12-characters
MPT_ADMIN_RECOVERY_CODE=replace-with-an-offline-recovery-code-at-least-16-characters
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# Free AI workspace text and image models share this Volcengine Ark key.
ARK_API_KEY=
ARK_TEXT_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_TEXT_MODEL=doubao-seed-2-1-pro-260628
ARK_IMAGE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_MODEL=doubao-seedream-5-0-260128
ARK_IMAGE_RESPONSE_FORMAT=b64_json
# Optional unattended initialization:
# MPT_TEACHER_USERNAME=
# MPT_TEACHER_PASSWORD=
# MPT_ADMIN_RECOVERY_CODE is required with unattended initialization
# MPT_CLASS_CODE=
# MPT_GROUP_CODE_PREFIX=
# MPT_GROUP_COUNT=
